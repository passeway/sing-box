{
  "log": {
    "level": "warn",
    "timestamp": true
  },
  "inbounds": [
    {
      "type": "hysteria2",
      "tag": "hysteria-in",
      "listen": "::",
      "listen_port": 40001,
      "users": [
        {
          "password": "REPLACE_WITH_HYSTERIA_PASSWORD"
        }
      ],
      "masquerade": "https://bing.com",
      "tls": {
        "enabled": true,
        "certificate_path": "/etc/sing-box/cert.pem",
        "key_path": "/etc/sing-box/key.pem",
        "alpn": [
          "h3"
        ]
      }
    },
    {
      "type": "vless",
      "tag": "vless-in",
      "listen": "::",
      "listen_port": 40002,
      "users": [
        {
          "uuid": "REPLACE_WITH_UUID",
          "flow": "xtls-rprx-vision"
        }
      ],
      "tls": {
        "enabled": true,
        "server_name": "www.ua.edu",
        "reality": {
          "enabled": true,
          "handshake": {
            "server": "www.ua.edu",
            "server_port": 443
          },
          "private_key": "REPLACE_WITH_REALITY_PRIVATE_KEY",
          "short_id": [
            "123abc"
          ]
        }
      }
    },
    {
      "type": "anytls",
      "tag": "anytls-in",
      "listen": "::",
      "listen_port": 40003,
      "users": [
        {
          "name": "REPLACE_WITH_UUID",
          "password": "REPLACE_WITH_REALITY_PUBLIC_KEY"
        }
      ],
      "tls": {
        "enabled": true,
        "certificate_path": "/etc/sing-box/cert.pem",
        "key_path": "/etc/sing-box/key.pem"
      }
    },
    {
      "type": "shadowsocks",
      "tag": "shadowsocks-in",
      "listen": "::",
      "listen_port": 40004,
      "method": "2022-blake3-aes-128-gcm",
      "password": "REPLACE_WITH_BASE64_16_BYTE_KEY",
      "multiplex": {
        "enabled": true
      }
    },
    {
      "type": "snell",
      "tag": "snell-in",
      "listen": "::",
      "listen_port": 40005,
      "version": 6,
      "psk": "REPLACE_WITH_RANDOM_SNELL_PSK",
      "mode": "default"
    }
  ],
  "outbounds": [
    {
      "type": "direct",
      "tag": "direct"
    }
  ]
}
